<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_MOCK_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.WRITE_STEPS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <queries>
        <package android:name="com.google.android.healthconnect.controller" />
    </queries>

    <application
        android:extractNativeLibs="true"
        android:label="PikminBot Tools"
        android:icon="@android:drawable/ic_menu_compass"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Unified engine service (v2): ONE service owns the single mock GPS
             provider, live-switchable between mock-pin and jog modes. This
             removes the intra-app conflict of the v1 MockService+JogService
             pair. exported=true so adb can drive it. Use the LONG option form
             for extras (two dashes before es / ef / ez) — a single dash makes
             am treat the value as a package name and silently drop the extras:
               am start-foreground-service -n com.pikminbot.tools/.EngineService
                 with string extra mode=pin, float extras lat and lon,
                 optional boolean extra persistent=true
                 (boolean persistent false = 90 s natural lifetime)
               mode=jog with jogmode=loop|straight, speed_kph, steps_per_sec,
                 radius_m, heading, duration_min; cmd=stop releases the mock
             Safe: injection fails unless THIS app holds the MOCK_LOCATION appop. -->
        <service
            android:name=".EngineService"
            android:exported="true"
            android:foregroundServiceType="location" />

        <!-- Adb broadcast entry (pbgw bridge compat): delegates to EngineService (pin).
             Must route through the Activity (foreground-service-from-receiver is
             denied on Android 14+). -->
        <receiver
            android:name=".MockLocationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.pikminbot.mock.SET_LOCATION" />
                <action android:name="com.pikminbot.mock.CLEAR_LOCATION" />
            </intent-filter>
        </receiver>

        <!-- Floating pairing helper. The system pairing dialog kills its server
             when it loses foreground, so the pairing form must float ON TOP of it. -->
        <service
            android:name=".PairOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the ADB pairing overlay alive while the system pairing dialog is focused" />
        </service>

        <!-- Mock time / date / timezone injection entry for adb + automation.
             Clock changes are privileged (SET_TIME), so the receiver delegates to
             the same root/Shizuku ladder the Time tab uses. Send the explicit
             component with the -n flag; implicit broadcasts are not delivered to
             another app's manifest receiver on Android 14+.
             Extras: epoch (long, ms since epoch), tz (Olson id), shift_hours
             (float), restore (boolean). Actions SET_TIME, RESTORE_TIME,
             TIME_STATUS. See MockTimeReceiver for the exact am invocations. -->
        <receiver
            android:name=".MockTimeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.pikminbot.mock.SET_TIME" />
                <action android:name="com.pikminbot.mock.RESTORE_TIME" />
                <action android:name="com.pikminbot.mock.TIME_STATUS" />
            </intent-filter>
        </receiver>

        <!-- Shizuku API bridge. Required for Shizuku.pingBinder()/newProcess():
             without this provider the API can never bind, which is why the
             Shizuku tier silently degraded to "not running". -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- In-app mock-location repair screen. Opened by the self-heal
             notification, by MainActivity, or directly over adb:
               am start -n com.pikminbot.tools/.RepairActivity -->
        <activity
            android:name=".RepairActivity"
            android:exported="true" />

        <!-- Required by Health Connect to READ records (VIEW_PERMISSION_USAGE) -->
        <activity
            android:name=".PermissionUsageActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.Dialog">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity>
    </application>
</manifest>
